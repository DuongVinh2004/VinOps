NODE_ENV=development
VINOPS_LOG_LEVEL=info
VINOPS_API_HOST=127.0.0.1
VINOPS_API_PORT=3000
VINOPS_DATABASE_URL=postgresql://vinops_app:replace-with-local-only-password@127.0.0.1:5432/vinops
VINOPS_AUTH_TOKEN_SECRET=replace-with-at-least-32-local-development-characters
VINOPS_ALLOWED_ORIGINS=http://127.0.0.1:5173
VINOPS_ACCESS_TOKEN_TTL_SECONDS=900
VINOPS_REFRESH_IDLE_TTL_DAYS=7
VINOPS_REFRESH_ABSOLUTE_TTL_DAYS=30
VINOPS_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
VINOPS_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
VINOPS_REFRESH_COOKIE_SECURE=false
VINOPS_WORKER_NAME=vinops-worker-local
VINOPS_S3_ENDPOINT=http://127.0.0.1:9000
VINOPS_S3_REGION=us-east-1
VINOPS_S3_BUCKET=vinops-files
VINOPS_S3_ACCESS_KEY_ID=replace-with-local-only-access-key
VINOPS_S3_SECRET_ACCESS_KEY=replace-with-local-only-secret-key
VINOPS_SIGNED_URL_TTL_SECONDS=60
VINOPS_CLAMAV_HOST=127.0.0.1
VINOPS_CLAMAV_PORT=3310
VINOPS_OUTBOX_POLL_INTERVAL_MS=1000
VINOPS_FILE_JOB_POLL_INTERVAL_MS=1000
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
VITE_APP_ENV=development
