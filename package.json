{
  "name": "vinops",
  "version": "0.0.0",
  "description": "Enterprise Digital Engineering & Common Data Environment (CDE) Platform for Capital Infrastructure Projects",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @vinops/web dev",
    "dev:web": "pnpm --filter @vinops/web dev",
    "dev:api": "pnpm --filter @vinops/api start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages scripts tests --max-warnings=0",
    "typecheck": "pnpm --recursive --sort run typecheck && tsc -p tests/tsconfig.json && tsc -b --pretty false",
    "test": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.e2e-spec.ts\" --exclude \"tests/rls-tenant-isolation.spec.ts\" --exclude \"tests/worker-fault-injection.spec.ts\" --exclude \"apps/worker/test/weather-dossier.test.ts\"",
    "test:all": "vitest run",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "test:migrate": "pnpm --filter @vinops/database... build && node scripts/migrate-test-dbs.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "contracts:lint": "redocly lint packages/contracts/openapi/vinops.openapi.yaml --config packages/contracts/redocly.yaml",
    "contracts:generate": "openapi-typescript packages/contracts/openapi/vinops.openapi.yaml -o packages/contracts/src/generated/openapi.ts",
    "contracts:check": "node scripts/check-generated.mjs",
    "contracts:verify": "pnpm contracts:lint && pnpm contracts:check",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "build": "pnpm --recursive --sort --if-present run build",
    "secret:scan": "node scripts/secret-scan.mjs",
    "license:check": "node scripts/license-check.mjs",
    "github:rules": "node scripts/configure-github-repository.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:verify && pnpm architecture:check && pnpm build && pnpm secret:scan && pnpm license:check",
    "verify:full": "pnpm verify && pnpm test:integration && node scripts/seal-evidence.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.51.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=2.1.4",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.18"
    }
  }
}
